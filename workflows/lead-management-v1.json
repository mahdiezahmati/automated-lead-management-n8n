    {
      "parameters": {
        "jsCode": "const budget = Number($json.body?.budget ?? $json.budget ?? 0);\nconst service = $json.body?.service ?? $json.service ?? \"\";\nconst source = $json.body?.source ?? $json.source ?? \"\";\nconst message = $json.body?.message ?? $json.message ?? \"\";\n\nlet score = 0;\n\n// 1. Budget\nif (budget >= 50000000) {\n  score += 40;\n} else if (budget >= 30000000) {\n  score += 25;\n}\n\n// 2. Service\nif (service === \"AI Automation\") {\n  score += 20;\n}\n\n// 3. Lead Source\nif (source === \"Website\") {\n  score += 10;\n}\n\n// 4. Message\nif (message.trim() !== \"\") {\n  score += 10;\n}\n\n// 5. Lead Category\nlet category;\n\nif (score >= 70) {\n  category = \"Hot\";\n} else if (score >= 40) {\n  category = \"Warm\";\n} else {\n  category = \"Cold\";\n}\n\n// Final Output\nreturn {\n  json: {\n    ...$json,\n\n    // Clean lead information\n    name: $json.body?.name ?? $json.name,\n    email: $json.body?.email ?? $json.email,\n    phone: $json.body?.phone ?? $json.phone,\n    company: $json.body?.company ?? $json.company,\n    service: service,\n    budget: budget,\n    source: source,\n    message: message,\n\n    // Lead scoring\n    leadScore: score,\n    leadCategory: category\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
